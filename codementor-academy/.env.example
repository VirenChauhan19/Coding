# Copy this file to `.env` and fill in values.
#
# --- Local development (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Production (Postgres, e.g. Neon/Vercel/Supabase) ---
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used to sign auth session JWTs. MUST be a long random string in prod.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- AI Tutor (optional, for future real AI integration) ---
# AI_PROVIDER="anthropic"
# ANTHROPIC_API_KEY=""
