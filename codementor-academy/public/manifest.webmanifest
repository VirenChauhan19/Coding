{
  "name": "CodeMentor Academy",
  "short_name": "CodeMentor",
  "description": "Your personal AI coding teacher — learn to code, level by level.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
